POSTGRES_USER=slotwise
POSTGRES_PASSWORD=change_me
POSTGRES_DB=slotwise
DATABASE_URL=postgresql+psycopg://slotwise:change_me@localhost:5432/slotwise

# development | test | production
# The app refuses to start in production unless COOKIE_SECURE=true.
ENVIRONMENT=development
# COOKIE_SECURE=true

# Comma-separated browser origins allowed to POST/PUT/PATCH/DELETE.
# In production set this to your real https origin only.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: real passwords for staff/admin in the seed (min 12 chars).
# Leave unset on any public deployment.
# SEED_STAFF_PASSWORD=
# SEED_ADMIN_PASSWORD=

# Public portfolio demo. When true:
# - the seed gives the staff and admin accounts their PUBLISHED demo passwords
#   (see backend/app/demo.py), so it cannot be combined with SEED_*_PASSWORD
# - `python -m scripts.reset_demo` wipes ALL data and reseeds it (non-demo users included)
# - the demo accounts skip the per-email login lock and cannot change their password
# Never enable on a deployment with real customers.
# DEMO_MODE=true
