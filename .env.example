POSTGRES_USER=slotwise
POSTGRES_PASSWORD=change_me
POSTGRES_DB=slotwise
DATABASE_URL=postgresql+psycopg://slotwise:change_me@localhost:5432/slotwise

# development | test | production
# The app refuses to start in production unless COOKIE_SECURE=true.
ENVIRONMENT=development
# COOKIE_SECURE=true

# Comma-separated browser origins allowed to POST/PUT/PATCH/DELETE.
# In production set this to your real https origin only.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: real passwords for staff/admin in the seed (min 12 chars).
# Leave unset on any public deployment.
# SEED_STAFF_PASSWORD=
# SEED_ADMIN_PASSWORD=
